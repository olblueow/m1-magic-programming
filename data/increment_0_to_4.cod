<?xml version="1.0" encoding="UTF-8"?>
<cockatrice_deck version="1">
    <deckname>Incrémentation 0 vers 4</deckname>
    <comments>
        Ce deck est 100% autonome. Le plateau commence vide.
        Les 5 premières cartes construisent la mémoire (000).
        Les cartes suivantes font les calculs d'incrémentation (+1) jusqu'à 100.
    </comments>
    <zone name="main">
        <card name="Slime Molding" annotation="Création Ooze position 0" />
        <card name="Slime Molding" annotation="Création Ooze position 1" />
        <card name="Slime Molding" annotation="Création Ooze position 2 (Cible active)" />
        <card name="Battlegrowth" annotation="Protection de la position 0" />
        <card name="Battlegrowth" annotation="Protection de la position 1" />

        <card name="Artificial Evolution" annotation="Ooze dies -> create Zombie" />
        <card name="Infest" annotation="Position 2: Ooze devient Zombie" />

        <card name="Artificial Evolution" annotation="Zombie dies -> create Ooze" />
        <card name="Infest" annotation="Position 2: Zombie devient Ooze (retenue)" />
        <card name="Fate Transfer" annotation="La cible se décale à GAUCHE (pos 1)" />
        <card name="Artificial Evolution" annotation="Ooze dies -> create Zombie" />
        <card name="Infest" annotation="Position 1: Ooze devient Zombie (fin de retenue)" />
        <card name="Bioshift" annotation="La cible revient à DROITE (pos 2)" />

        <card name="Artificial Evolution" annotation="Ooze dies -> create Zombie" />
        <card name="Infest" annotation="Position 2: Ooze devient Zombie" />

        <card name="Artificial Evolution" annotation="Zombie dies -> create Ooze" />
        <card name="Infest" annotation="Position 2: Zombie devient Ooze (retenue 1)" />
        <card name="Fate Transfer" annotation="La cible se décale à GAUCHE (pos 1)" />
        <card name="Artificial Evolution" annotation="Zombie dies -> create Ooze" />
        <card name="Infest" annotation="Position 1: Zombie devient Ooze (retenue 2)" />
        <card name="Fate Transfer" annotation="La cible se décale à GAUCHE (pos 0)" />
        <card name="Artificial Evolution" annotation="Ooze dies -> create Zombie" />
        <card name="Infest" annotation="Position 0: Ooze devient Zombie (fin de retenue)" />
        <card name="Bioshift" annotation="La cible revient à DROITE (pos 1)" />
        <card name="Bioshift" annotation="La cible revient à DROITE (pos 2)" />
    </zone>
</cockatrice_deck>