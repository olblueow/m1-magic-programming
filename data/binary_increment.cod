<?xml version="1.0" encoding="UTF-8"?>
<cockatrice_deck version="1">

  <deckname>IncrementZeroToFour</deckname>

  <comments>
TAPE: 0,0,0
HEAD: 2
ALGORITHM: Increment 0 to 4 (four successive +1 operations)
INPUT: 000 (decimal 0)
EXPECTED: 100 (decimal 4)
NOTE: Setup phase uses Slime Molding (create Ooze) and Battlegrowth (add counter)
  </comments>

  <zone name="main">

    <!-- ═══════════════════════════════════════════════
         PHASE 1: SETUP — Initialize the battlefield
         Create 3 Ooze tokens (bits), protect positions 0 and 1
         Position 2 = HEAD (no counter, 2/2, vulnerable)
    ═══════════════════════════════════════════════ -->

    <card number="1" name="Slime Molding"
          annotation="SETUP | Create Ooze(0) at position 0"/>

    <card number="1" name="Slime Molding"
          annotation="SETUP | Create Ooze(0) at position 1"/>

    <card number="1" name="Slime Molding"
          annotation="SETUP | Create Ooze(0) at position 2 — this is the HEAD"/>

    <card number="1" name="Battlegrowth"
          annotation="SETUP | Add +1/+1 counter to position 0 → protected (3/3)"/>

    <card number="1" name="Battlegrowth"
          annotation="SETUP | Add +1/+1 counter to position 1 → protected (3/3)"/>

    <!-- Tape ready: [0, 0, 0] — HEAD at position 2 -->

    <!-- ═══════════════════════════════════════════════
         CYCLE 1: 000 → 001  (+1)
         HEAD at pos 2 = Ooze(0) → write 1
    ═══════════════════════════════════════════════ -->

    <card number="1" name="Artificial Evolution"
          annotation="Ooze dies → create Zombie"/>

    <card number="1" name="Infest"
          annotation="CYCLE1 | pos 2: Ooze(0) → Zombie(1) | no carry"/>

    <!-- Reposition head back to pos 2 (already there) -->
    <!-- Result: [0, 0, 1] = 1 -->

    <!-- ═══════════════════════════════════════════════
         CYCLE 2: 001 → 010  (+1 with carry)
         HEAD at pos 2 = Zombie(1) → write 0, carry left
    ═══════════════════════════════════════════════ -->

    <card number="1" name="Artificial Evolution"
          annotation="Zombie dies → create Ooze"/>

    <card number="1" name="Infest"
          annotation="CYCLE2 | pos 2: Zombie(1) → Ooze(0) | carry propagates"/>

    <card number="1" name="Fate Transfer"
          annotation="CYCLE2 | MOVE_LEFT to pos 1"/>

    <card number="1" name="Artificial Evolution"
          annotation="Ooze dies → create Zombie"/>

    <card number="1" name="Infest"
          annotation="CYCLE2 | pos 1: Ooze(0) → Zombie(1) | carry resolved"/>

    <card number="1" name="Bioshift"
          annotation="CYCLE2 | MOVE_RIGHT back to pos 2"/>

    <!-- Result: [0, 1, 0] = 2 -->

    <!-- ═══════════════════════════════════════════════
         CYCLE 3: 010 → 011  (+1)
         HEAD at pos 2 = Ooze(0) → write 1
    ═══════════════════════════════════════════════ -->

    <card number="1" name="Artificial Evolution"
          annotation="Ooze dies → create Zombie"/>

    <card number="1" name="Infest"
          annotation="CYCLE3 | pos 2: Ooze(0) → Zombie(1) | no carry"/>

    <!-- Result: [0, 1, 1] = 3 -->

    <!-- ═══════════════════════════════════════════════
         CYCLE 4: 011 → 100  (+1 with double carry)
         HEAD at pos 2 = Zombie(1) → write 0, carry left
    ═══════════════════════════════════════════════ -->

    <card number="1" name="Artificial Evolution"
          annotation="Zombie dies → create Ooze"/>

    <card number="1" name="Infest"
          annotation="CYCLE4 | pos 2: Zombie(1) → Ooze(0) | carry propagates"/>

    <card number="1" name="Fate Transfer"
          annotation="CYCLE4 | MOVE_LEFT to pos 1"/>

    <card number="1" name="Artificial Evolution"
          annotation="Zombie dies → create Ooze"/>

    <card number="1" name="Infest"
          annotation="CYCLE4 | pos 1: Zombie(1) → Ooze(0) | carry propagates"/>

    <card number="1" name="Fate Transfer"
          annotation="CYCLE4 | MOVE_LEFT to pos 0"/>

    <card number="1" name="Artificial Evolution"
          annotation="Ooze dies → create Zombie"/>

    <card number="1" name="Infest"
          annotation="CYCLE4 | pos 0: Ooze(0) → Zombie(1) | carry resolved"/>

    <card number="1" name="Bioshift"
          annotation="CYCLE4 | MOVE_RIGHT back to pos 1"/>

    <card number="1" name="Bioshift"
          annotation="CYCLE4 | MOVE_RIGHT back to pos 2"/>

    <!-- Result: [1, 0, 0] = 4 ✓ — HALT -->

  </zone>

</cockatrice_deck>
